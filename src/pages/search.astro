---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/paths';
---

<BaseLayout title="Search">
  <h1>Search Posts</h1>
  <link href={withBase('/pagefind/pagefind-ui.css')} rel="stylesheet" />
  <script src={withBase('/pagefind/pagefind-ui.js')} defer is:inline></script>
  <div id="search-box"></div>
  <script is:inline define:vars={{ bundlePath: withBase('/pagefind/') }}>
    window.addEventListener('DOMContentLoaded', () => {
      const box = document.getElementById('search-box');
      if (typeof PagefindUI !== 'undefined') {
        new PagefindUI({
          element: box,
          showSubResults: true,
          bundlePath,
          translations: {
            placeholder: 'Search posts…',
            zero_results: 'No results for "[SEARCH_TERM]"',
          },
        });
      } else if (box) {
        box.innerHTML =
          '<p>The search index has not been generated yet. It is available after running <code>npm run build && npm run preview</code>.</p>';
      }
    });
  </script>
</BaseLayout>
