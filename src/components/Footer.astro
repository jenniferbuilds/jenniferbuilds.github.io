---
import { withBase } from '../lib/paths';
import { SITE_TITLE } from '../consts';

const links = [
  { label: 'Blog', href: withBase('/blog/') },
  { label: 'Tags', href: withBase('/tags/') },
  { label: 'Categories', href: withBase('/categories/') },
  { label: 'RSS', href: withBase('/rss.xml') },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p>&copy; {new Date().getFullYear()} {SITE_TITLE}</p>
    <nav class="footer-nav">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</footer>
