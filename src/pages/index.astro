---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostLine from '../components/PostLine.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---

<BaseLayout>
  <section class="intro">
    <h1>Hi, I'm Jennifer.</h1>
    <p>I love books, cooking, and building things.</p>
    <p>I'm a software engineer exploring AI, agents, and systems. I write about what I learn, what I build, and sometimes what breaks along the way.</p>
  </section>

  {
    posts.length === 0 ? (
      <p class="page-intro">Nothing published yet.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <PostLine id={post.id} title={post.data.title} date={post.data.pubDate} body={post.body} />
        ))}
      </ul>
    )
  }
</BaseLayout>
