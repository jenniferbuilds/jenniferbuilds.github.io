---
import { SITE_TITLE } from '../consts';
import { withBase } from '../lib/paths';
import ThemeToggle from './ThemeToggle.astro';

const navItems = [
  { label: 'Home', href: withBase('/') },
  { label: 'Notes', href: withBase('/notes') },
  { label: 'Projects', href: withBase('/projects') },
  { label: 'About', href: withBase('/about') },
];

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
---

<header class="site-header">
  <nav class="container nav">
    <a href={withBase('/')} class="logo">{SITE_TITLE}</a>
    <ul class="nav-list">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'nav-link',
                { active: item.href === withBase('/') ? pathname === '/' : pathname.startsWith(new URL(item.href, 'http://x').pathname.replace(import.meta.env.BASE_URL, '/')) },
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a href={withBase('/search/')} class="icon-link" aria-label="Search" title="Search">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.3-4.3"></path>
      </svg>
    </a>
    <ThemeToggle />
  </nav>
</header>
