---
import { withBase } from '../lib/paths';
import { readingTimeMinutes } from '../lib/reading-time';

interface Props {
  id: string;
  title: string;
  date: Date;
  body?: string;
}

const { id, title, date, body } = Astro.props;
const dateStr = date.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
});
const meta = body ? `${dateStr} · ${readingTimeMinutes(body)} min read` : dateStr;
---

<li>
  <a class="post-title" href={withBase(`/blog/${id}/`)}>{title}</a>
  <p class="meta">{meta}</p>
</li>
