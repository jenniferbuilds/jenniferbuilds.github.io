---
import { withBase } from '../lib/paths';

const navItems = [
  { label: 'Blog', href: withBase('/blog') },
  { label: 'About', href: withBase('/about') },
  { label: 'Search', href: withBase('/search') },
];

const pathname = Astro.url.pathname.replace(import.meta.env.BASE_URL, '/');
---

<header class="site-header">
  <nav class="container nav">
    <a href={withBase('/')} class="logo">Jennifer</a>
    <ul class="nav-list">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[
                'nav-link',
                { active: pathname.startsWith(new URL(item.href, 'http://x').pathname.replace(import.meta.env.BASE_URL, '/')) },
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
